import StringFormal.NoGhost.SeedTransferSix

/-!
# The transverse half of `[GAP-N6-seed]`: `x₄v` and `y₃v` are singular vectors of `V(26, -4)`

Graph nodes: `worldsheet.ddf-spanning-hypothesis`, `worldsheet.no-ghost-theorem-v4`.
This is **PR-D2 of blueprint `formal/BLUEPRINT-noghost.md` §B⁗.2 / §B⁗.9** — the *transverse*
half of the `N = 6` seed criterion.  The *longitudinal* half is already closed in
`NoGhost/SeedTransferSix.lean` (`towerLop_one_apply_y3_towerLop_neg_one_of_eq_neg_five`).

## What is proved

For a **seed** `φ` (annihilated by every `L_n`, `n ≥ 1`) of `L_0`-weight `h`, on the momentum
tower with central charge `c = D`:

| operator | `L_1` image | `L_2` image |
|---|---|---|
| `y₃φ` | `(12h + 48)·L_{-2}φ + (6h + 24)·L_{-1}²φ` | `(42h + 3D + 90)·L_{-1}φ` |
| `x₄φ` | `-(104h + 416)·L_{-3}φ - (80h + 320)·L_{-2}L_{-1}φ - (24h + 96)·L_{-1}³φ` | `-(216h + 12D + 552)·L_{-2}φ - (188h + 10D + 492)·L_{-1}²φ` |

(`towerLop_one_apply_y3`, `towerLop_two_apply_y3`, `towerLop_one_apply_x4`,
`towerLop_two_apply_x4`; all four hold for **every** `h`, every `D`, every `ℚ`-algebra `R`.)

⭐ **Where `c = 26` enters.**  Both `L_1` rows are *independent of the central charge* and both
vanish identically at `h = -4`: every commutator feeding them (`⁅L_1, L_{-n}⁆ = (1+n)L_{-(n-1)}`,
`⁅L_1, L_{-1}⁆ = 2L_0`) is off the diagonal `m + n = 0` with `|m| ≥ 2`, so no central term has an
entry point — exactly as was found for the longitudinal identity in `SeedTransferSix.lean`.  The
central charge enters **only through the two `L_2` rows**, via the single Gram entry
`⁅L_2, L_{-2}⁆ = 4L_0 + c/2` (`towerLop_two_apply_towerLop_neg_two`).  Specialised to `h = -4`:

* `L_2 (y₃φ) = 3(D - 26) · L_{-1}φ`  (`towerLop_two_apply_y3_of_eq_neg_four`)
* `L_2 (x₄φ) = 12(26 - D) · L_{-2}φ + 10(26 - D) · L_{-1}²φ`
  (`towerLop_two_apply_x4_of_eq_neg_four`)

so **`D = 26` is exactly the condition for `x₄φ` and `y₃φ` to be singular** — and the
`26` is *produced*, not assumed: `towerLop_two_apply_y3_eq_zero_iff` states the converse over a
domain.  This is the first place in the `N = 6` thread where the critical dimension is consumed;
`SeedTransferSix.lean`'s longitudinal half never sees it.

## Main results

* `towerLop_eq_zero_of_pos_of_one_two` — a reusable Virasoro fact: if `L_1 w = L_2 w = 0` then
  `L_n w = 0` for **every** `n ≥ 1`.  (`⁅L_1, L_k⁆ = (1-k)L_{k+1}` with `1 - k` invertible in a
  `ℚ`-algebra for `k ≥ 2`.)  Mathlib has nothing of the sort; the repository previously only had
  the *grading* argument, which cannot reach `n = 3` on a level-3 word.
* ⭐⭐⭐ `y3_mem_towerPositiveModeSubmodule` / `x4_mem_towerPositiveModeSubmodule` — **the
  transverse half**: at `(c, h) = (26, -4)`, `y₃φ` and `x₄φ` are singular vectors, i.e. they lie
  in `towerPositiveModeSubmodule`.
* `towerLop_two_apply_y3_eq_zero_iff` — the converse over a `CharZero` domain: with `L_{-1}φ ≠ 0`
  the transverse half **forces** `(D : R) = 26`.

## ⚠ Correction to blueprint §B⁗.2

§B⁗.2 asserts, for general `c`, that `L_{-1}L_2(x₄v) = (26 - c)·y₃v`.  **This is false**; the
correct identity, which the present file's `towerLop_two_apply_x4_of_eq_neg_four` gives (apply
`L_{-1}` and use `towerLop_neg_one_apply_towerLop_neg_two`), is

`L_{-1}L_2(x₄v) = (26 - c)·(12 L_{-3} + 12 L_{-2}L_{-1} + 10 L_{-1}³)v`,

whose bracket is **not** `y₃v = (12L_{-3} + 6L_{-2}L_{-1} + L_{-1}³)v`.  §B⁗.2's slip is to feed
`φ := y₃v` into `NullSeedsTwo.towerLop_two_apply_descTwo_of_eigenvalue`, whose hypothesis `hpos`
("`φ` is a seed") holds for `y₃v` **only when `c = 26`**; off `c = 26` the two correction terms
`2L_{-2}(L_2 y₃v) + 3L_{-1}²(L_2 y₃v)` are exactly the discrepancy.  The *conclusion* §B⁗.2 draws
("`x₄v ∈ Q₄ ⟺ c = 26`") is nevertheless correct, and is proved here directly.

## What is **not** done here

* The bidegree bookkeeping `φ ∈ Q_{j,M} ⟹ y₃φ ∈ Q_{j,M+3}, x₄φ ∈ Q_{j,M+4}` (i.e. §B⁗.9's
  "`u ∈ Q_{-6,1} ⟹ x₄u ∈ Q_{-6,5} ∧ y₃u ∈ Q_{-6,4}`") — a separate, purely combinatorial step
  on top of `NullSeedsTwo.descTwo_mem_towerBigrade`'s pattern.
* The `N = 6` seed criterion itself (`x₄u ∈ Q_{-6,5} ∧ y₃u ∈ Q_{-6,4} ⟹ u ∈ Q_{-6,1}`) needs, on
  top of this file and `SeedTransferSix.lean`'s longitudinal half, the Fock-space decomposition of
  a level-1 tower state into `c ⊥ p` and `c ∥ p` parts plus `y₃|0;p_{-6}⟩ ≠ 0`.
* `b26_six` and `ddfSpans_bigrade_neg_six_six` (they additionally need the level-6 occupation
  count, blueprint PR-E).
-/

namespace StringFormal.NoGhost

/-! ### `L_1` and `L_2` are the only conditions: positive modes are generated by them

`⁅L_1, L_k⁆ = (1 - k) L_{k+1}`, and `1 - k` is invertible in a `ℚ`-algebra once `k ≥ 2`.  So a
vector killed by `L_1` and `L_2` is killed by every `L_n`, `n ≥ 1`.  This is what turns the four
computations below into a *singular vector* statement. -/

section Generation

variable {D : ℕ} {R : Type*} [CommRing R] [Algebra ℚ R] (η a b : Fin D → R)
variable (hη : ∀ μ, η μ * η μ = 1)

/-- In a `ℚ`-algebra a nonzero integer scalar may be cancelled from a module element. -/
lemma eq_zero_of_intCast_smul_eq_zero' {M : Type*} [AddCommGroup M] [Module R M] {k : ℤ}
    (hk : k ≠ 0) {y : M} (hy : (k : R) • y = 0) : y = 0 := by
  have hq : (algebraMap ℚ R ((k : ℚ)⁻¹)) * (k : R) = 1 := by
    rw [show ((k : ℤ) : R) = algebraMap ℚ R ((k : ℤ) : ℚ) from (map_intCast _ k).symm,
      ← map_mul, inv_mul_cancel₀ (by exact_mod_cast hk : ((k : ℚ)) ≠ 0), map_one]
  calc y = (1 : R) • y := (one_smul R y).symm
    _ = ((algebraMap ℚ R ((k : ℚ)⁻¹)) * (k : R)) • y := by rw [hq]
    _ = (algebraMap ℚ R ((k : ℚ)⁻¹)) • ((k : R) • y) := mul_smul _ _ _
    _ = 0 := by rw [hy, smul_zero]

include hη in
/-- **`L_1` and `L_2` generate the positive modes.**  If `L_1 w = 0` and `L_2 w = 0` then
`L_n w = 0` for every `n ≥ 1`.

The induction step is `⁅L_1, L_k⁆ = (1 - k) L_{k+1}` (no central term: `1 + k ≠ 0` for `k ≥ 1`),
and `1 - k` is a unit of any `ℚ`-algebra once `k ≥ 2`.  No grading, no finiteness, no hypothesis
on `w` beyond the two equations. -/
theorem towerLop_eq_zero_of_pos_of_one_two {w : TowerFock D R}
    (h1 : towerLop η a b 1 w = 0) (h2 : towerLop η a b 2 w = 0) :
    ∀ n : ℤ, 0 < n → towerLop η a b n w = 0 := by
  have key : ∀ k : ℕ, towerLop η a b ((k : ℤ) + 1) w = 0 := by
    intro k
    induction k with
    | zero => simpa using h1
    | succ k ih =>
      rcases Nat.eq_zero_or_pos k with rfl | hk
      · simpa using h2
      · have hne : ((1 : ℤ) + ((k : ℤ) + 1)) ≠ 0 := by omega
        have hc := towerLop_apply_towerLop_of_ne_zero η a b hη hne w
        rw [ih, map_zero, h1, map_zero, zero_add,
          show (1 : ℤ) + ((k : ℤ) + 1) = ((k : ℤ) + 1) + 1 by ring,
          show ((1 : ℤ) : R) - (((k : ℤ) + 1 : ℤ) : R) = ((-(k : ℤ) : ℤ) : R) by
            push_cast; ring] at hc
        have hz := eq_zero_of_intCast_smul_eq_zero' (R := R) (k := -(k : ℤ))
          (by omega) hc.symm
        push_cast
        exact hz
  intro n hn
  obtain ⟨k, rfl⟩ : ∃ k : ℕ, n = (k : ℤ) + 1 := ⟨(n - 1).toNat, by omega⟩
  exact key k

end Generation

/-! ### The `L_1` / `L_2` atoms on level-3 and level-4 words

`φ` is a seed of weight `h` throughout.  Each atom is one or two applications of
`towerLop_apply_towerLop`.  The four atoms of `SeedTransferSix.lean`
(`towerLop_one_apply_towerLop_neg_one_{sq,cube,pow_four}`,
`towerLop_one_apply_towerLop_neg_{three,two}_towerLop_neg_one{,_sq}`) and the six of
`NullSeedsTwo.lean` are reused, not restated. -/

section Atoms

variable {D : ℕ} {R : Type*} [CommRing R] [Algebra ℚ R] (η a b : Fin D → R)
variable (hη : ∀ μ, η μ * η μ = 1) {h : R} {φ : TowerFock D R}
variable (hpos : ∀ n : ℤ, 0 < n → towerLop η a b n φ = 0)
variable (h0 : towerLop η a b 0 φ = h • φ)

include hη hpos in
/-- `L_1 L_{-3} φ = 4 L_{-2} φ`. -/
lemma towerLop_one_apply_towerLop_neg_three :
    towerLop η a b 1 (towerLop η a b (-3) φ) = (4 : R) • towerLop η a b (-2) φ := by
  have hc := towerLop_apply_towerLop_of_ne_zero η a b hη (m := 1) (n := -3) (by decide) φ
  rw [show (1 : ℤ) + -3 = -2 by decide] at hc
  rw [hc, hpos 1 one_pos, map_zero, zero_add]
  match_scalars
  ring

include hη hpos in
/-- `L_1 L_{-4} φ = 5 L_{-3} φ`. -/
lemma towerLop_one_apply_towerLop_neg_four :
    towerLop η a b 1 (towerLop η a b (-4) φ) = (5 : R) • towerLop η a b (-3) φ := by
  have hc := towerLop_apply_towerLop_of_ne_zero η a b hη (m := 1) (n := -4) (by decide) φ
  rw [show (1 : ℤ) + -4 = -3 by decide] at hc
  rw [hc, hpos 1 one_pos, map_zero, zero_add]
  match_scalars
  ring

include hη hpos in
/-- `L_2 L_{-3} φ = 5 L_{-1} φ`. -/
lemma towerLop_two_apply_towerLop_neg_three :
    towerLop η a b 2 (towerLop η a b (-3) φ) = (5 : R) • towerLop η a b (-1) φ := by
  have hc := towerLop_apply_towerLop_of_ne_zero η a b hη (m := 2) (n := -3) (by decide) φ
  rw [show (2 : ℤ) + -3 = -1 by decide] at hc
  rw [hc, hpos 2 (by decide), map_zero, zero_add]
  match_scalars
  ring

include hη hpos in
/-- `L_2 L_{-4} φ = 6 L_{-2} φ`. -/
lemma towerLop_two_apply_towerLop_neg_four :
    towerLop η a b 2 (towerLop η a b (-4) φ) = (6 : R) • towerLop η a b (-2) φ := by
  have hc := towerLop_apply_towerLop_of_ne_zero η a b hη (m := 2) (n := -4) (by decide) φ
  rw [show (2 : ℤ) + -4 = -2 by decide] at hc
  rw [hc, hpos 2 (by decide), map_zero, zero_add]
  match_scalars
  ring

include hη hpos h0 in
/-- `L_1 (L_{-2} L_{-1} φ) = 3 L_{-1}²φ + 2h L_{-2}φ`. -/
lemma towerLop_one_apply_towerLop_neg_two_towerLop_neg_one :
    towerLop η a b 1 (towerLop η a b (-2) (towerLop η a b (-1) φ))
      = (3 : R) • towerLop η a b (-1) (towerLop η a b (-1) φ)
        + (2 * h) • towerLop η a b (-2) φ := by
  have hc := towerLop_apply_towerLop_of_ne_zero η a b hη (m := 1) (n := -2) (by decide)
    (towerLop η a b (-1) φ)
  rw [show (1 : ℤ) + -2 = -1 by decide] at hc
  rw [hc, towerLop_one_apply_towerLop_neg_one η a b hη hpos h0, map_smul]
  match_scalars <;> ring

include hη hpos in
/-- `L_1 (L_{-2} L_{-2} φ) = 6 L_{-2}L_{-1}φ + 3 L_{-3}φ`. -/
lemma towerLop_one_apply_towerLop_neg_two_sq :
    towerLop η a b 1 (towerLop η a b (-2) (towerLop η a b (-2) φ))
      = (6 : R) • towerLop η a b (-2) (towerLop η a b (-1) φ)
        + (3 : R) • towerLop η a b (-3) φ := by
  have hc := towerLop_apply_towerLop_of_ne_zero η a b hη (m := 1) (n := -2) (by decide)
    (towerLop η a b (-2) φ)
  rw [show (1 : ℤ) + -2 = -1 by decide] at hc
  rw [hc, towerLop_one_apply_towerLop_neg_two η a b hη hpos, map_smul,
    towerLop_neg_one_apply_towerLop_neg_two η a b hη φ]
  match_scalars <;> ring

include hη hpos in
/-- `L_2 (L_{-3} L_{-1} φ) = 5 L_{-1}²φ`. -/
lemma towerLop_two_apply_towerLop_neg_three_towerLop_neg_one :
    towerLop η a b 2 (towerLop η a b (-3) (towerLop η a b (-1) φ))
      = (5 : R) • towerLop η a b (-1) (towerLop η a b (-1) φ) := by
  have hc := towerLop_apply_towerLop_of_ne_zero η a b hη (m := 2) (n := -3) (by decide)
    (towerLop η a b (-1) φ)
  rw [show (2 : ℤ) + -3 = -1 by decide] at hc
  rw [hc, towerLop_two_apply_towerLop_neg_one η a b hη hpos, map_zero, zero_add]
  match_scalars
  ring

include hη hpos h0 in
/-- `L_2 (L_{-1}²φ) = 6h φ`. -/
lemma towerLop_two_apply_towerLop_neg_one_sq :
    towerLop η a b 2 (towerLop η a b (-1) (towerLop η a b (-1) φ)) = (6 * h) • φ := by
  have hc := towerLop_apply_towerLop_of_ne_zero η a b hη (m := 2) (n := -1) (by decide)
    (towerLop η a b (-1) φ)
  rw [show (2 : ℤ) + -1 = 1 by decide] at hc
  rw [hc, towerLop_two_apply_towerLop_neg_one η a b hη hpos, map_zero, zero_add,
    towerLop_one_apply_towerLop_neg_one η a b hη hpos h0]
  match_scalars
  ring

include hη hpos h0 in
/-- `L_2 (L_{-1}³φ) = (18h + 6) L_{-1}φ`. -/
lemma towerLop_two_apply_towerLop_neg_one_cube :
    towerLop η a b 2
        (towerLop η a b (-1) (towerLop η a b (-1) (towerLop η a b (-1) φ)))
      = (18 * h + 6) • towerLop η a b (-1) φ := by
  have hc := towerLop_apply_towerLop_of_ne_zero η a b hη (m := 2) (n := -1) (by decide)
    (towerLop η a b (-1) (towerLop η a b (-1) φ))
  rw [show (2 : ℤ) + -1 = 1 by decide] at hc
  rw [hc, towerLop_two_apply_towerLop_neg_one_sq η a b hη hpos h0,
    towerLop_one_apply_towerLop_neg_one_sq η a b hη hpos h0, map_smul]
  match_scalars; ring

include hη hpos h0 in
/-- `L_2 (L_{-1}⁴φ) = (36h + 24) L_{-1}²φ`. -/
lemma towerLop_two_apply_towerLop_neg_one_pow_four :
    towerLop η a b 2
        (towerLop η a b (-1) (towerLop η a b (-1)
          (towerLop η a b (-1) (towerLop η a b (-1) φ))))
      = (36 * h + 24) • towerLop η a b (-1) (towerLop η a b (-1) φ) := by
  have hc := towerLop_apply_towerLop_of_ne_zero η a b hη (m := 2) (n := -1) (by decide)
    (towerLop η a b (-1) (towerLop η a b (-1) (towerLop η a b (-1) φ)))
  rw [show (2 : ℤ) + -1 = 1 by decide] at hc
  rw [hc, towerLop_two_apply_towerLop_neg_one_cube η a b hη hpos h0,
    towerLop_one_apply_towerLop_neg_one_cube η a b hη hpos h0, map_smul]
  match_scalars; ring

include hη hpos h0 in
/-- `L_2 (L_{-2} L_{-1} φ) = (4h + 4 + c/2) L_{-1}φ`, `c/2 = D·centralTerm 2`.  **The first of
the two places the central charge can enter**: `⁅L_2, L_{-2}⁆ = 4L_0 + c/2`. -/
lemma towerLop_two_apply_towerLop_neg_two_towerLop_neg_one :
    towerLop η a b 2 (towerLop η a b (-2) (towerLop η a b (-1) φ))
      = (4 * h + 4 + (D : R) * Virasoro.centralTerm R 2) • towerLop η a b (-1) φ := by
  have hc := towerLop_apply_towerLop_neg η a b hη 2 (towerLop η a b (-1) φ)
  rw [hc, towerLop_two_apply_towerLop_neg_one η a b hη hpos, map_zero, zero_add,
    towerLop_zero_apply_towerLop_neg_one η a b hη h0]
  match_scalars
  ring

include hη hpos h0 in
/-- `L_2 (L_{-2} L_{-2} φ) = (8h + 8 + c) L_{-2}φ`, `c = D`.  Here the two `c/2`'s add up, so the
central term appears with an integral coefficient. -/
lemma towerLop_two_apply_towerLop_neg_two_sq :
    towerLop η a b 2 (towerLop η a b (-2) (towerLop η a b (-2) φ))
      = (8 * h + 8 + (D : R)) • towerLop η a b (-2) φ := by
  have hc := towerLop_apply_towerLop_neg η a b hη 2 (towerLop η a b (-2) φ)
  rw [hc, towerLop_two_apply_towerLop_neg_two η a b hη hpos h0,
    towerLop_zero_apply_towerLop_neg_two η a b hη h0, map_add, map_smul, map_smul]
  match_scalars
  linear_combination (D : R) * two_mul_centralTerm_two_eq_one R

include hη hpos h0 in
/-- `L_2 (L_{-2} L_{-1}² φ) = (4h + 8 + c/2) L_{-1}²φ + 6h L_{-2}φ`. -/
lemma towerLop_two_apply_towerLop_neg_two_towerLop_neg_one_sq :
    towerLop η a b 2
        (towerLop η a b (-2) (towerLop η a b (-1) (towerLop η a b (-1) φ)))
      = (4 * h + 8 + (D : R) * Virasoro.centralTerm R 2)
          • towerLop η a b (-1) (towerLop η a b (-1) φ)
        + (6 * h) • towerLop η a b (-2) φ := by
  have hc := towerLop_apply_towerLop_neg η a b hη 2
    (towerLop η a b (-1) (towerLop η a b (-1) φ))
  rw [hc, towerLop_two_apply_towerLop_neg_one_sq η a b hη hpos h0,
    towerLop_zero_apply_towerLop_neg_one_sq η a b hη h0, map_smul]
  match_scalars <;> ring

end Atoms

/-! ### The four rows: `L_1` and `L_2` on `y₃φ` and `x₄φ` -/

section Rows

variable {D : ℕ} {R : Type*} [CommRing R] [Algebra ℚ R] (η a b : Fin D → R)
variable (hη : ∀ μ, η μ * η μ = 1) {h : R} {φ : TowerFock D R}
variable (hpos : ∀ n : ℤ, 0 < n → towerLop η a b n φ = 0)
variable (h0 : towerLop η a b 0 φ = h • φ)

include hη hpos h0 in
/-- ⭐ **`L_1 (y₃ φ) = (12h + 48) L_{-2}φ + (6h + 24) L_{-1}²φ`**, for every `h` and every `D`.

The **central charge does not appear**: the three commutators used (`⁅L_1, L_{-3}⁆ = 4L_{-2}`,
`⁅L_1, L_{-2}⁆ = 3L_{-1}`, `⁅L_1, L_{-1}⁆ = 2L_0`) are all off the central diagonal.  Both
coefficients vanish at `h = -4`: this is blueprint §B⁗.2's "`L_1(y₃φ) = 0` 对一切 `c`". -/
theorem towerLop_one_apply_y3 :
    towerLop η a b 1 (y3 η a b φ)
      = (12 * h + 48) • towerLop η a b (-2) φ
        + (6 * h + 24) • towerLop η a b (-1) (towerLop η a b (-1) φ) := by
  simp only [y3_apply, map_add, map_smul]
  rw [towerLop_one_apply_towerLop_neg_three η a b hη hpos,
    towerLop_one_apply_towerLop_neg_two_towerLop_neg_one η a b hη hpos h0,
    towerLop_one_apply_towerLop_neg_one_cube η a b hη hpos h0]
  match_scalars <;> ring

include hη hpos h0 in
/-- ⭐⭐ **`L_2 (y₃ φ) = (42h + 3c + 90) L_{-1}φ`**, `c = D`, for every `h` and every `D`.

**This is one of the two entry points of the central charge** in the `N = 6` thread; it enters
through the single Gram entry `⁅L_2, L_{-2}⁆ = 4L_0 + c/2`.  At `h = -4` the coefficient is
`3(c - 26)`. -/
theorem towerLop_two_apply_y3 :
    towerLop η a b 2 (y3 η a b φ)
      = (42 * h + 3 * (D : R) + 90) • towerLop η a b (-1) φ := by
  simp only [y3_apply, map_add, map_smul]
  rw [towerLop_two_apply_towerLop_neg_three η a b hη hpos,
    towerLop_two_apply_towerLop_neg_two_towerLop_neg_one η a b hη hpos h0,
    towerLop_two_apply_towerLop_neg_one_cube η a b hη hpos h0]
  match_scalars
  linear_combination (3 * (D : R)) * two_mul_centralTerm_two_eq_one R

include hη hpos h0 in
/-- ⭐ **`L_1 (x₄ φ) = -(104h + 416) L_{-3}φ - (80h + 320) L_{-2}L_{-1}φ - (24h + 96) L_{-1}³φ`**,
for every `h` and every `D`.  The central charge does not appear, and all three coefficients
vanish at `h = -4` (they are `-8(h+4)·(13, 10, 3)`). -/
theorem towerLop_one_apply_x4 :
    towerLop η a b 1 (x4 η a b φ)
      = (-104 * h - 416) • towerLop η a b (-3) φ
        + (-80 * h - 320) • towerLop η a b (-2) (towerLop η a b (-1) φ)
        + (-24 * h - 96) • towerLop η a b (-1) (towerLop η a b (-1) (towerLop η a b (-1) φ)) := by
  simp only [x4_apply, map_add, map_smul]
  rw [towerLop_one_apply_towerLop_neg_four η a b hη hpos,
    towerLop_one_apply_towerLop_neg_three_towerLop_neg_one η a b hη hpos h0,
    towerLop_one_apply_towerLop_neg_two_sq η a b hη hpos,
    towerLop_one_apply_towerLop_neg_two_towerLop_neg_one_sq η a b hη hpos h0,
    towerLop_one_apply_towerLop_neg_one_pow_four η a b hη hpos h0]
  match_scalars <;> ring

include hη hpos h0 in
/-- ⭐⭐ **`L_2 (x₄ φ) = -(216h + 12c + 552) L_{-2}φ - (188h + 10c + 492) L_{-1}²φ`**, `c = D`,
for every `h` and every `D`.  The second entry point of the central charge; at `h = -4` the
coefficients become `12(26 - c)` and `10(26 - c)`. -/
theorem towerLop_two_apply_x4 :
    towerLop η a b 2 (x4 η a b φ)
      = (-216 * h - 12 * (D : R) - 552) • towerLop η a b (-2) φ
        + (-188 * h - 10 * (D : R) - 492)
            • towerLop η a b (-1) (towerLop η a b (-1) φ) := by
  simp only [x4_apply, map_add, map_smul]
  rw [towerLop_two_apply_towerLop_neg_four η a b hη hpos,
    towerLop_two_apply_towerLop_neg_three_towerLop_neg_one η a b hη hpos,
    towerLop_two_apply_towerLop_neg_two_sq η a b hη hpos h0,
    towerLop_two_apply_towerLop_neg_two_towerLop_neg_one_sq η a b hη hpos h0,
    towerLop_two_apply_towerLop_neg_one_pow_four η a b hη hpos h0]
  match_scalars
  · ring
  · linear_combination (-10 * (D : R)) * two_mul_centralTerm_two_eq_one R

end Rows

/-! ### Specialisation to `h = -4`: the critical dimension is produced, not assumed -/

section WeightMinusFour

variable {D : ℕ} {R : Type*} [CommRing R] [Algebra ℚ R] (η a b : Fin D → R)
variable (hη : ∀ μ, η μ * η μ = 1) {h : R} {φ : TowerFock D R}
variable (hpos : ∀ n : ℤ, 0 < n → towerLop η a b n φ = 0)
variable (h0 : towerLop η a b 0 φ = h • φ)

include hη hpos h0 in
/-- `L_1 (y₃ φ) = 0` at `h = -4`, **for every central charge** (blueprint §B⁗.2). -/
theorem towerLop_one_apply_y3_of_eq_neg_four (hh : h = -4) :
    towerLop η a b 1 (y3 η a b φ) = 0 := by
  rw [towerLop_one_apply_y3 η a b hη hpos h0, hh]
  match_scalars <;> ring

include hη hpos h0 in
/-- ⭐⭐ `L_2 (y₃ φ) = 3(c - 26) · L_{-1}φ` at `h = -4` (blueprint §B⁗.2's second
"`c - 26` equation"). -/
theorem towerLop_two_apply_y3_of_eq_neg_four (hh : h = -4) :
    towerLop η a b 2 (y3 η a b φ) = (3 * ((D : R) - 26)) • towerLop η a b (-1) φ := by
  rw [towerLop_two_apply_y3 η a b hη hpos h0, hh]
  match_scalars
  ring

include hη hpos h0 in
/-- `L_1 (x₄ φ) = 0` at `h = -4`, **for every central charge**. -/
theorem towerLop_one_apply_x4_of_eq_neg_four (hh : h = -4) :
    towerLop η a b 1 (x4 η a b φ) = 0 := by
  rw [towerLop_one_apply_x4 η a b hη hpos h0, hh]
  match_scalars <;> ring

include hη hpos h0 in
/-- ⭐⭐ `L_2 (x₄ φ) = 12(26 - c) L_{-2}φ + 10(26 - c) L_{-1}²φ` at `h = -4`.

⚠ Blueprint §B⁗.2 writes the `L_{-1}`-image of this as `(26 - c)·y₃v`; that is **wrong** (see the
module docstring).  Applying `L_{-1}` here and normal-ordering gives
`(26 - c)(12 L_{-3} + 12 L_{-2}L_{-1} + 10 L_{-1}³)v`, not `(26 - c) y₃ v`.  The conclusion
"`x₄v` is singular iff `c = 26`" is unaffected. -/
theorem towerLop_two_apply_x4_of_eq_neg_four (hh : h = -4) :
    towerLop η a b 2 (x4 η a b φ)
      = (12 * (26 - (D : R))) • towerLop η a b (-2) φ
        + (10 * (26 - (D : R))) • towerLop η a b (-1) (towerLop η a b (-1) φ) := by
  rw [towerLop_two_apply_x4 η a b hη hpos h0, hh]
  match_scalars <;> ring

end WeightMinusFour

/-! ### ⭐⭐⭐ The transverse half: `x₄φ`, `y₃φ` are singular vectors of `V(26, -4)` -/

section Singular

variable {D : ℕ} {R : Type*} [CommRing R] [Algebra ℚ R] (η a b : Fin D → R)
variable (hη : ∀ μ, η μ * η μ = 1) {h : R} {φ : TowerFock D R}
variable (hpos : ∀ n : ℤ, 0 < n → towerLop η a b n φ = 0)
variable (h0 : towerLop η a b 0 φ = h • φ)

include hη hpos h0 in
/-- ⭐⭐⭐ **`y₃φ` is a singular vector of `V(26, -4)`**: for a seed `φ` of weight `h = -4` in
critical dimension `(D : R) = 26`, every positive Virasoro mode annihilates `y₃φ`.

`L_1` is `c`-free and vanishes because `h = -4`; `L_2` vanishes because `c = 26`; everything
above is generated by those two (`towerLop_eq_zero_of_pos_of_one_two`). -/
theorem y3_mem_towerPositiveModeSubmodule (hD26 : (D : R) = 26) (hh : h = -4) :
    y3 η a b φ ∈ towerPositiveModeSubmodule η a b := by
  refine mem_towerPositiveModeSubmodule.2
    (towerLop_eq_zero_of_pos_of_one_two η a b hη ?_ ?_)
  · exact towerLop_one_apply_y3_of_eq_neg_four η a b hη hpos h0 hh
  · rw [towerLop_two_apply_y3_of_eq_neg_four η a b hη hpos h0 hh, hD26]
    match_scalars
    ring

include hη hpos h0 in
/-- ⭐⭐⭐ **`x₄φ` is a singular vector of `V(26, -4)`** — the level-4 partner of
`y3_mem_towerPositiveModeSubmodule`.  Blueprint §B⁗.2 obtains this indirectly (from
`L_{-1}`-injectivity plus `𝒟₂y₃v`'s physicality); here it is a direct computation, which is what
makes the correction in the module docstring visible. -/
theorem x4_mem_towerPositiveModeSubmodule (hD26 : (D : R) = 26) (hh : h = -4) :
    x4 η a b φ ∈ towerPositiveModeSubmodule η a b := by
  refine mem_towerPositiveModeSubmodule.2
    (towerLop_eq_zero_of_pos_of_one_two η a b hη ?_ ?_)
  · exact towerLop_one_apply_x4_of_eq_neg_four η a b hη hpos h0 hh
  · rw [towerLop_two_apply_x4_of_eq_neg_four η a b hη hpos h0 hh, hD26]
    match_scalars <;> ring

include hη hpos h0 in
/-- ⭐⭐ **`c = 26` is necessary**: over a domain, for a seed of weight `-4` with
`L_{-1}φ ≠ 0`, `L_2(y₃φ) = 0` **iff** `(D : R) = 26`.  So the transverse half of `[GAP-N6-seed]`
is an equivalence, not merely an implication — the critical dimension is *produced* by the
computation. -/
theorem towerLop_two_apply_y3_eq_zero_iff [NoZeroDivisors R] [CharZero R] (hh : h = -4)
    (hne : towerLop η a b (-1) φ ≠ 0) :
    towerLop η a b 2 (y3 η a b φ) = 0 ↔ (D : R) = 26 := by
  rw [towerLop_two_apply_y3_of_eq_neg_four η a b hη hpos h0 hh, smul_eq_zero]
  constructor
  · rintro (hc | hc)
    · rcases mul_eq_zero.1 hc with h3 | h3
      · exact absurd h3 (by norm_num)
      · exact sub_eq_zero.1 h3
    · exact absurd hc hne
  · intro hD26
    exact Or.inl (by rw [hD26]; ring)

end Singular

end StringFormal.NoGhost
