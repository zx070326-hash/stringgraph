import StringFormal.Virasoro.Verma

/-!
# `L₀`-grading of descendants in an arbitrary Virasoro module

Graph node: `worldsheet.descendant-weight-grading`
Convention: `conv.virasoro-standard` (as in `StringFormal.Virasoro.Basic`).

`Verma.lean` proves the `L₀`-eigenvalue formula for words acting on the generator of the Verma
module `V(c,h)`.  This file states and proves the same formula in **any** module `M` over the
Virasoro algebra, acting on **any** vector `v` with `⁅L₀, v⁆ = h • v`:

* `StringFormal.Virasoro.wordActOn`: the action of the word `L_{n_1} ⋯ L_{n_k}` on `v : M`
  (same `List.foldr` construction as `Verma.wordAct`, which it specialises to by `rfl`).
* `StringFormal.Virasoro.lie_lgen_zero_wordActOn`: `L₀` acts on `L_{n_1} ⋯ L_{n_k} v` by the
  scalar `h - (n_1 + ⋯ + n_k)`.  Taking `n_i = -k_i` with `k_i ≥ 1` gives the graph node's
  `h + Σ k_i`.
* `StringFormal.Virasoro.lie_lgen_zero_wordActOn_of_isHighestWeightVector`: the same for a
  highest weight vector in the sense of `IsHighestWeightVector`.

Note that only the `L₀`-eigenvector hypothesis is used: neither the annihilation condition
`⁅L_n, v⁆ = 0` for `n > 0` nor the central character enters the computation, because the
central term of `⁅L_0, L_n⁆` vanishes identically (`centralTerm R 0 = 0`).

Not formalised here: that the vectors `wordActOn R M l v` are linearly independent, that they
span the submodule generated by `v`, or that `M` decomposes into `L₀`-eigenspaces — all of these
need extra hypotheses (PBW / complete reducibility) and are recorded as gaps on the graph node.
-/

namespace StringFormal.Virasoro

section DescendantGrading

variable (R : Type*) [CommRing R] [Algebra ℚ R]
  (M : Type*) [AddCommGroup M] [Module R M] [LieRingModule (VirasoroAlgebra R) M]
  [LieModule R (VirasoroAlgebra R) M]

/-- The action of the word `L_{n_1} ⋯ L_{n_k}` on a vector of an arbitrary Virasoro module,
for `l = [n_1, …, n_k]`. -/
noncomputable def wordActOn (l : List ℤ) (v : M) : M :=
  l.foldr (fun n x => ⁅VirasoroAlgebra.lgen R n, x⁆) v

omit [Module R M] [LieModule R (VirasoroAlgebra R) M] in
@[simp] lemma wordActOn_nil (v : M) : wordActOn R M [] v = v := rfl

omit [Module R M] [LieModule R (VirasoroAlgebra R) M] in
@[simp] lemma wordActOn_cons (n : ℤ) (l : List ℤ) (v : M) :
    wordActOn R M (n :: l) v = ⁅VirasoroAlgebra.lgen R n, wordActOn R M l v⁆ := rfl

/-- On the Verma module, `wordActOn` is `Verma.wordAct`. -/
lemma wordActOn_verma (c h : R) (l : List ℤ) (v : VermaModule R c h) :
    wordActOn R (VermaModule R c h) l v = wordAct R c h l v := rfl

/-- **`L₀`-grading of descendants.**  In any Virasoro module `M`, if `v` is an `L₀`-eigenvector
of eigenvalue `h`, then `L_{n_1} ⋯ L_{n_k} v` is an `L₀`-eigenvector of eigenvalue
`h - (n_1 + ⋯ + n_k)`.  With `n_i = -k_i`, `k_i ≥ 1`, this is the weight `h + Σ k_i` of
`worldsheet.descendant-weight-grading`. -/
theorem lie_lgen_zero_wordActOn (h : R) {v : M}
    (hv : ⁅VirasoroAlgebra.lgen R 0, v⁆ = h • v) (l : List ℤ) :
    ⁅VirasoroAlgebra.lgen R 0, wordActOn R M l v⁆
      = (h - ((l.sum : ℤ) : R)) • wordActOn R M l v := by
  induction l with
  | nil => simpa using hv
  | cons a t ih =>
    rw [wordActOn_cons, List.sum_cons, leibniz_lie, VirasoroAlgebra.lie_lgen_lgen]
    simp only [smul_lie, zero_add, centralTerm_zero, ite_self, zero_smul, add_zero]
    rw [ih, lie_smul, ← add_smul]
    congr 1
    push_cast
    ring

/-- The `L₀`-grading of descendants of a highest weight vector.  Only the `L₀`-eigenvector part
of `IsHighestWeightVector` is used. -/
theorem lie_lgen_zero_wordActOn_of_isHighestWeightVector (c h : R) {v : M}
    (hv : IsHighestWeightVector R c h M v) (l : List ℤ) :
    ⁅VirasoroAlgebra.lgen R 0, wordActOn R M l v⁆
      = (h - ((l.sum : ℤ) : R)) • wordActOn R M l v :=
  lie_lgen_zero_wordActOn R M h hv.lie_lgen_zero l

/-- Descendants of a highest weight vector are images of the corresponding Verma descendants
under `vermaLift`; the grading above is the transport of `lie_lgen_zero_wordAct`. -/
lemma vermaLift_wordAct (c h : R) {v : M} (hv : IsHighestWeightVector R c h M v) (l : List ℤ) :
    vermaLift R c h M hv (wordAct R c h l (hwv R c h)) = wordActOn R M l v := by
  induction l with
  | nil => simp [vermaLift_hwv R c h M hv]
  | cons a t ih => rw [wordAct_cons, vermaLift_lie, ih, wordActOn_cons]

end DescendantGrading

end StringFormal.Virasoro
