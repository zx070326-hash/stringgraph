import Mathlib.Algebra.Lie.Extension
import StringFormal.Virasoro.Witt

/-!
# The Virasoro algebra

Graph node: `worldsheet.virasoro-algebra`
Convention: `conv.virasoro-standard`
  `[L_m, L_n] = (m - n) L_{m+n} + (c/12) m (m² - 1) δ_{m+n,0}`

## Main definitions

* `StringFormal.Virasoro.virasoroCocycle`: the Virasoro 2-cocycle of the Witt algebra with
  trivial coefficients in the ground ring `R`.
* `StringFormal.Virasoro.VirasoroAlgebra R`: the Virasoro algebra over a `ℚ`-algebra `R`,
  defined as the central extension `LieAlgebra.ofTwoCocycle (virasoroCocycle R)`.
  It carries `LieRing` and `LieAlgebra R` instances (inherited from Mathlib).
* `StringFormal.Virasoro.VirasoroAlgebra.lgen`, `.cgen`: the generators `L n` and the central
  element `C`.

## Main statements

* `StringFormal.Virasoro.VirasoroAlgebra.lie_lgen_lgen`:
  `⁅L n, L m⁆ = (n - m) • L (n + m) + (if n + m = 0 then (n³ - n)/12 else 0) • C`,
  which is the convention `conv.virasoro-standard` with `C` the central element.
* `StringFormal.Virasoro.VirasoroAlgebra.lie_cgen`, `.cgen_lie`, `.ofCentre_lie`: the centre is
  central.
* `StringFormal.Virasoro.VirasoroAlgebra.toWitt_surjective`,
  `.ofCentre_injective`, `.toWitt_eq_zero_iff`: exactness of
  `0 → R → VirasoroAlgebra R → WittAlgebra R → 0`.
* `StringFormal.Virasoro.VirasoroAlgebra.span_lgen_cgen_eq_top`: the `L n` together with `C`
  span `VirasoroAlgebra R` as an `R`-module, via the linear splitting
  `StringFormal.Virasoro.VirasoroAlgebra.ofWitt` of `toWitt` (a splitting of `R`-modules only;
  it is *not* a Lie algebra map).

## Implementation notes

The ground ring is a commutative `ℚ`-algebra `R`; this is exactly what is needed to make sense
of the `1/12` in the standard normalisation, and it is weaker than requiring a field of
characteristic zero. `ℚ`, `ℝ`, `ℂ` all qualify via `DivisionRing.toRatAlgebra`.

The 2-cocycle is defined as the antisymmetrisation `γ - γᵀ` of
`γ (ℓ m) (ℓ n) = δ_{m+n,0} (m³ - m)/24`, so that the alternating condition `γ X X = 0`
required by `LieModule.Cohomology.twoCochain` holds by `sub_self`, for every `X`, without any
hypothesis on `R`.

## Status

Complete, no `sorry`. **Not** formalised here: that this central extension is the *unique*
nontrivial one-dimensional central extension of the Witt algebra, i.e. that
`H²(WittAlgebra R, R) ≅ R` is generated by the class of `virasoroCocycle`. Mathlib
`v4.33.1` has 2-cocycles but no 2-coboundaries or cohomology quotient. See
`formal/NOTES-virasoro-reuse.md`.
-/

namespace StringFormal.Virasoro

open Module LieModule.Cohomology

section TrivialModule

variable (R : Type*) [CommRing R]

/-- The ground ring `R` as a module over the Witt algebra with the trivial action. This is the
coefficient module for the Virasoro 2-cocycle; the resulting extension is central. -/
instance : LieRingModule (WittAlgebra R) R where
  bracket _ _ := 0
  add_lie _ _ _ := (add_zero (0 : R)).symm
  lie_add _ _ _ := (add_zero (0 : R)).symm
  leibniz_lie _ _ _ := (add_zero (0 : R)).symm

@[simp]
lemma witt_lie_ground (X : WittAlgebra R) (r : R) : ⁅X, r⁆ = (0 : R) := rfl

instance : LieModule R (WittAlgebra R) R where
  smul_lie c _ _ := (smul_zero c).symm
  lie_smul c _ _ := (smul_zero c).symm

instance : LieModule.IsTrivial (WittAlgebra R) R where
  trivial _ _ := rfl

end TrivialModule

section Cocycle

variable (R : Type*) [CommRing R] [Algebra ℚ R]

/-- `1/12` in a commutative `ℚ`-algebra. -/
noncomputable def inv12 : R := algebraMap ℚ R (1 / 12)

/-- `1/24` in a commutative `ℚ`-algebra. -/
noncomputable def inv24 : R := algebraMap ℚ R (1 / 24)

lemma twelve_mul_inv12 : (12 : R) * inv12 R = 1 := by
  rw [inv12, ← map_ofNat (algebraMap ℚ R) 12, ← map_mul,
    show (12 : ℚ) * (1 / 12) = 1 by norm_num, map_one]

lemma two_mul_inv24 : (2 : R) * inv24 R = inv12 R := by
  rw [inv24, inv12, ← map_ofNat (algebraMap ℚ R) 2, ← map_mul]
  congr 1
  norm_num

/-- The central term `(n³ - n)/12 = n(n² - 1)/12` of the Virasoro bracket. -/
noncomputable def centralTerm (n : ℤ) : R := inv12 R * ((n ^ 3 - n : ℤ) : R)

/-- Half of `centralTerm`; used to write the Virasoro cocycle as an antisymmetrisation. -/
noncomputable def halfCentralTerm (n : ℤ) : R := inv24 R * ((n ^ 3 - n : ℤ) : R)

lemma two_mul_halfCentralTerm (n : ℤ) : (2 : R) * halfCentralTerm R n = centralTerm R n := by
  rw [halfCentralTerm, centralTerm, ← mul_assoc, two_mul_inv24]

lemma halfCentralTerm_neg (n : ℤ) : halfCentralTerm R (-n) = - halfCentralTerm R n := by
  rw [halfCentralTerm, halfCentralTerm]
  push_cast
  ring

lemma centralTerm_eq (n : ℤ) : centralTerm R n = inv12 R * ((n * (n ^ 2 - 1) : ℤ) : R) := by
  rw [centralTerm]
  congr 2
  ring

lemma centralTerm_zero : centralTerm R (0 : ℤ) = 0 := by
  simp [centralTerm]

/-- Auxiliary bilinear form with `cocycleAux (ℓ m) (ℓ n) = δ_{m+n,0} (m³ - m)/24`.
The Virasoro cocycle is its antisymmetrisation. -/
noncomputable def cocycleAux : WittAlgebra R →ₗ[R] WittAlgebra R →ₗ[R] R :=
  (WittAlgebra.lgen R).constr R fun n => (WittAlgebra.lgen R).constr R fun m =>
    if n + m = 0 then halfCentralTerm R n else 0

lemma cocycleAux_lgen_lgen (n m : ℤ) :
    cocycleAux R (WittAlgebra.lgen R n) (WittAlgebra.lgen R m)
      = if n + m = 0 then halfCentralTerm R n else 0 := by
  simp only [cocycleAux, Basis.constr_basis]

/-- The Virasoro cocycle as a bilinear form:
`cocycleBilin (ℓ m) (ℓ n) = δ_{m+n,0} (m³ - m)/12`. -/
noncomputable def cocycleBilin : WittAlgebra R →ₗ[R] WittAlgebra R →ₗ[R] R :=
  cocycleAux R - (cocycleAux R).flip

lemma cocycleBilin_apply_apply (X Y : WittAlgebra R) :
    cocycleBilin R X Y = cocycleAux R X Y - cocycleAux R Y X := by
  simp only [cocycleBilin, LinearMap.sub_apply, LinearMap.flip_apply]

lemma cocycleBilin_self (X : WittAlgebra R) : cocycleBilin R X X = 0 := by
  rw [cocycleBilin_apply_apply, sub_self]

lemma cocycleBilin_lgen_lgen (n m : ℤ) :
    cocycleBilin R (WittAlgebra.lgen R n) (WittAlgebra.lgen R m)
      = if n + m = 0 then centralTerm R n else 0 := by
  rw [cocycleBilin_apply_apply, cocycleAux_lgen_lgen, cocycleAux_lgen_lgen]
  by_cases h : n + m = 0
  · have hm : m = -n := by omega
    rw [if_pos h, if_pos (show m + n = 0 by omega), if_pos h, hm, halfCentralTerm_neg,
      sub_neg_eq_add, ← two_mul, two_mul_halfCentralTerm]
  · rw [if_neg h, if_neg (show ¬(m + n = 0) by omega), if_neg h, sub_zero]

/-- The Virasoro cocycle as a `2`-cochain of the Witt algebra with coefficients in `R`. -/
noncomputable def virasoroCochain : twoCochain R (WittAlgebra R) R :=
  ⟨cocycleBilin R, mem_twoCochain_iff.mpr (cocycleBilin_self R)⟩

lemma virasoroCochain_apply (X Y : WittAlgebra R) :
    virasoroCochain R X Y = cocycleBilin R X Y := rfl

lemma virasoroCochain_lgen_lgen (n m : ℤ) :
    virasoroCochain R (WittAlgebra.lgen R n) (WittAlgebra.lgen R m)
      = if n + m = 0 then centralTerm R n else 0 := by
  rw [virasoroCochain_apply, cocycleBilin_lgen_lgen]

/-- The Virasoro `2`-cocycle: the (up to scale and coboundary, unique) nontrivial class in
`H²(WittAlgebra R, R)`. Only the cocycle condition is proved here, not the nontriviality. -/
noncomputable def virasoroCocycle : twoCocycle R (WittAlgebra R) R :=
  ⟨virasoroCochain R, by
    rw [mem_twoCocycle_iff]
    apply LinearMap.ext_basis (WittAlgebra.lgen R) (WittAlgebra.lgen R)
    intro n m
    simp only [LinearMap.zero_apply]
    apply (WittAlgebra.lgen R).ext
    intro k
    rw [LinearMap.zero_apply, d₂₃_apply]
    simp only [trivial_lie_zero, sub_zero, add_zero, zero_sub, WittAlgebra.lie_lgen_lgen,
      map_smul, LinearMap.smul_apply, smul_eq_mul, virasoroCochain_lgen_lgen]
    by_cases h : n + m + k = 0
    · rw [if_pos h, if_pos (show n + k + m = 0 by omega),
        if_pos (show m + k + n = 0 by omega)]
      have hk : k = -n - m := by omega
      subst hk
      simp only [centralTerm]
      push_cast
      ring
    · rw [if_neg h, if_neg (show ¬(n + k + m = 0) by omega),
        if_neg (show ¬(m + k + n = 0) by omega)]
      ring⟩

lemma virasoroCocycle_apply (X Y : WittAlgebra R) :
    (virasoroCocycle R : WittAlgebra R →ₗ[R] WittAlgebra R →ₗ[R] R) X Y
      = cocycleBilin R X Y := rfl

end Cocycle

section VirasoroAlgebra

variable (R : Type*) [CommRing R] [Algebra ℚ R]

/-- **The Virasoro algebra** over a commutative `ℚ`-algebra `R`: the one-dimensional central
extension of the Witt algebra determined by the Virasoro `2`-cocycle. -/
def VirasoroAlgebra : Type _ := LieAlgebra.ofTwoCocycle (virasoroCocycle R)

namespace VirasoroAlgebra

noncomputable instance : AddCommGroup (VirasoroAlgebra R) :=
  inferInstanceAs (AddCommGroup (LieAlgebra.ofTwoCocycle (virasoroCocycle R)))

noncomputable instance : Module R (VirasoroAlgebra R) :=
  inferInstanceAs (Module R (LieAlgebra.ofTwoCocycle (virasoroCocycle R)))

noncomputable instance instLieRing : LieRing (VirasoroAlgebra R) :=
  inferInstanceAs (LieRing (LieAlgebra.ofTwoCocycle (virasoroCocycle R)))

noncomputable instance instLieAlgebra : LieAlgebra R (VirasoroAlgebra R) :=
  inferInstanceAs (LieAlgebra R (LieAlgebra.ofTwoCocycle (virasoroCocycle R)))

/-- The linear equivalence identifying the Virasoro algebra with `WittAlgebra R × R`.
This is *not* a Lie algebra map: the second component of the bracket is twisted by the
cocycle. -/
noncomputable def toProd : VirasoroAlgebra R ≃ WittAlgebra R × R :=
  (LieAlgebra.ofProd (virasoroCocycle R)).symm

/-- The generators `L n`, `n : ℤ`, of the Virasoro algebra. -/
noncomputable def lgen (n : ℤ) : VirasoroAlgebra R :=
  (toProd R).symm (WittAlgebra.lgen R n, 0)

/-- The central element `C` of the Virasoro algebra. -/
noncomputable def cgen : VirasoroAlgebra R := (toProd R).symm (0, 1)

@[simp] lemma toProd_lgen (n : ℤ) : toProd R (lgen R n) = (WittAlgebra.lgen R n, 0) := rfl

@[simp] lemma toProd_cgen : toProd R (cgen R) = (0, 1) := rfl

@[simp] lemma toProd_add (X Y : VirasoroAlgebra R) :
    toProd R (X + Y) = toProd R X + toProd R Y := rfl

@[simp] lemma toProd_smul (c : R) (X : VirasoroAlgebra R) :
    toProd R (c • X) = c • toProd R X := rfl

@[simp] lemma toProd_zero : toProd R (0 : VirasoroAlgebra R) = 0 := rfl

lemma toProd_lie (X Y : VirasoroAlgebra R) :
    toProd R ⁅X, Y⁆ =
      (⁅(toProd R X).1, (toProd R Y).1⁆,
        cocycleBilin R (toProd R X).1 (toProd R Y).1 + ⁅(toProd R X).1, (toProd R Y).2⁆
          - ⁅(toProd R Y).1, (toProd R X).2⁆) := rfl

lemma toProd_injective : Function.Injective (toProd R) := (toProd R).injective

/-- The defining relation of the Virasoro algebra, in the convention
`conv.virasoro-standard`. -/
@[simp]
lemma lie_lgen_lgen (n m : ℤ) :
    ⁅lgen R n, lgen R m⁆ = ((n : R) - (m : R)) • lgen R (n + m)
      + (if n + m = 0 then centralTerm R n else 0) • cgen R := by
  apply toProd_injective
  rw [toProd_lie]
  simp only [toProd_lgen, toProd_add, toProd_smul, toProd_cgen, witt_lie_ground,
    WittAlgebra.lie_lgen_lgen, cocycleBilin_lgen_lgen, Prod.smul_mk, Prod.mk_add_mk,
    smul_zero, smul_eq_mul, mul_one, mul_zero, add_zero, sub_zero, zero_add]

/-- The central element is central. -/
@[simp]
lemma cgen_lie (X : VirasoroAlgebra R) : ⁅cgen R, X⁆ = 0 := by
  apply toProd_injective
  rw [toProd_lie]
  simp only [toProd_cgen, toProd_zero, witt_lie_ground, Prod.mk_eq_zero]
  refine ⟨?_, ?_⟩
  · rw [zero_lie]
  · rw [map_zero, LinearMap.zero_apply, add_zero, sub_zero]

@[simp]
lemma lie_cgen (X : VirasoroAlgebra R) : ⁅X, cgen R⁆ = 0 := by
  rw [← lie_skew, cgen_lie, neg_zero]

/-- The projection `VirasoroAlgebra R → WittAlgebra R` of the central extension. -/
noncomputable def toWitt : VirasoroAlgebra R →ₗ⁅R⁆ WittAlgebra R where
  toFun X := (toProd R X).1
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  map_lie' := rfl

@[simp] lemma toWitt_apply (X : VirasoroAlgebra R) : toWitt R X = (toProd R X).1 := rfl

/-- The inclusion of the centre, `r ↦ r • C`. -/
noncomputable def ofCentre : R →ₗ[R] VirasoroAlgebra R where
  toFun r := (toProd R).symm (0, r)
  map_add' r s := by
    apply toProd_injective
    simp only [toProd_add, Equiv.apply_symm_apply, Prod.mk_add_mk, add_zero]
  map_smul' c r := by
    apply toProd_injective
    simp only [toProd_smul, Equiv.apply_symm_apply, Prod.smul_mk, smul_zero, smul_eq_mul,
      RingHom.id_apply]

@[simp] lemma toProd_ofCentre (r : R) : toProd R (ofCentre R r) = (0, r) := rfl

lemma ofCentre_one : ofCentre R 1 = cgen R := rfl

@[simp] lemma toWitt_lgen (n : ℤ) : toWitt R (lgen R n) = WittAlgebra.lgen R n := rfl

@[simp] lemma toWitt_cgen : toWitt R (cgen R) = 0 := rfl

@[simp] lemma toWitt_ofCentre (r : R) : toWitt R (ofCentre R r) = 0 := rfl

/-- The elements of the centre are central: this is what makes the extension a *central*
extension. -/
@[simp]
lemma ofCentre_lie (r : R) (X : VirasoroAlgebra R) : ⁅ofCentre R r, X⁆ = 0 := by
  apply toProd_injective
  rw [toProd_lie]
  simp only [toProd_ofCentre, toProd_zero, witt_lie_ground, zero_lie, map_zero,
    LinearMap.zero_apply, add_zero, sub_zero, Prod.mk_eq_zero, and_self]

@[simp]
lemma lie_ofCentre (X : VirasoroAlgebra R) (r : R) : ⁅X, ofCentre R r⁆ = 0 := by
  rw [← lie_skew, ofCentre_lie, neg_zero]

lemma toWitt_surjective : Function.Surjective (toWitt R) :=
  fun w => ⟨(toProd R).symm (w, 0), rfl⟩

lemma ofCentre_injective : Function.Injective (ofCentre R) := by
  intro r s h
  simpa using congrArg (fun X => (toProd R X).2) h

/-- Exactness of `0 → R → VirasoroAlgebra R → WittAlgebra R → 0` in the middle: the kernel of
the projection is exactly the centre. Together with `toWitt_surjective`,
`ofCentre_injective` and `ofCentre_lie` this says that `VirasoroAlgebra R` is a
one-dimensional central extension of `WittAlgebra R`. -/
lemma toWitt_eq_zero_iff (X : VirasoroAlgebra R) :
    toWitt R X = 0 ↔ ∃ r : R, X = ofCentre R r := by
  constructor
  · intro h
    refine ⟨(toProd R X).2, toProd_injective R ?_⟩
    rw [toProd_ofCentre]
    exact Prod.ext_iff.mpr ⟨h, rfl⟩
  · rintro ⟨r, rfl⟩
    rw [toWitt_ofCentre]

/-! ### The Virasoro algebra is spanned by `L n` and `C` -/

/-- `toProd` upgraded to an `R`-linear equivalence `VirasoroAlgebra R ≃ₗ WittAlgebra R × R`. -/
noncomputable def toProdₗ : VirasoroAlgebra R ≃ₗ[R] WittAlgebra R × R where
  toFun := toProd R
  invFun := (toProd R).symm
  map_add' := toProd_add R
  map_smul' := toProd_smul R
  left_inv := (toProd R).left_inv
  right_inv := (toProd R).right_inv

/-- The linear (**not** Lie algebra) splitting `WittAlgebra R → VirasoroAlgebra R`,
`ℓ n ↦ L n`. -/
noncomputable def ofWitt : WittAlgebra R →ₗ[R] VirasoroAlgebra R :=
  ((toProdₗ R).symm : WittAlgebra R × R →ₗ[R] VirasoroAlgebra R) ∘ₗ
    LinearMap.inl R (WittAlgebra R) R

@[simp] lemma toProd_ofWitt (w : WittAlgebra R) : toProd R (ofWitt R w) = (w, 0) := rfl

@[simp] lemma ofWitt_lgen (n : ℤ) : ofWitt R (WittAlgebra.lgen R n) = lgen R n := rfl

/-- The Virasoro algebra is spanned by the generators `L n`, `n : ℤ`, together with the central
element `C`. -/
lemma span_lgen_cgen_eq_top :
    Submodule.span R (insert (cgen R) (Set.range (lgen R))) = ⊤ := by
  rw [eq_top_iff]
  intro X _
  have hX : X = ofWitt R (toWitt R X) + (toProd R X).2 • cgen R := by
    apply toProd_injective
    rw [toProd_add, toProd_smul, toProd_cgen, toProd_ofWitt, toWitt_apply]
    ext <;> simp
  have hw : toWitt R X ∈ Submodule.span R (Set.range (WittAlgebra.lgen R)) := by
    rw [(WittAlgebra.lgen R).span_eq]
    exact Submodule.mem_top
  have h1 : ofWitt R (toWitt R X) ∈ Submodule.span R (Set.range (lgen R)) := by
    have hmem : ofWitt R (toWitt R X)
        ∈ (Submodule.span R (Set.range (WittAlgebra.lgen R))).map (ofWitt R) :=
      Submodule.mem_map_of_mem hw
    rwa [Submodule.map_span, ← Set.range_comp,
      show (ofWitt R ∘ WittAlgebra.lgen R) = lgen R from rfl] at hmem
  rw [hX]
  exact Submodule.add_mem _ (Submodule.span_mono (Set.subset_insert _ _) h1)
    (Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_insert _ _)))

end VirasoroAlgebra

end VirasoroAlgebra

/-- Sanity check that the instances are actually usable on a concrete ground ring. -/
noncomputable example : LieAlgebra ℚ (VirasoroAlgebra ℚ) := inferInstance

end StringFormal.Virasoro
